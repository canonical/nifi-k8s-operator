#
# NiFi properties — generated by the nifi-k8s Juju charm.
# Manual edits will be overwritten on the next reconcile.

# Core
nifi.nar.library.directory=./lib
nifi.nar.library.autoload.directory=./extensions
nifi.flowcontroller.graceful.shutdown.period=10 sec
nifi.flowservice.writedelay.interval=500 ms

# Authentication (Required for http mode only)
nifi.security.allow.anonymous.authentication=true

# Network
nifi.web.http.host={{ http_host }}
nifi.web.http.port={{ http_port }}

# To encrypt passwords used inside the database (mandatory)
nifi.sensitive.props.key={{ sensitive_props_key }}
nifi.sensitive.props.algorithm=NIFI_PBKDF2_AES_GCM_256

# Juju storage directory mappings
nifi.flow.configuration.file={{ data_dir }}/conf/flow.json.gz
nifi.database.directory={{ data_dir }}/database_repository
nifi.flowfile.repository.directory={{ data_dir }}/flowfile_repository
nifi.content.repository.directory.default={{ content_repo_dir }}
nifi.provenance.repository.directory.default={{ provenance_repo_dir }}

# State Management
nifi.state.management.configuration.file=./conf/state-management.xml
nifi.state.management.provider.local=local-provider
