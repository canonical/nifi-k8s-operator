<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
    NiFi authorizers — generated by the nifi-k8s Juju charm.
    Manual edits are overwritten on each reconcile while the certificates
    relation exists.
    NiFi reads the initial identities only while the users and authorizations
    files are empty, so the charm identity must never change.
-->
<authorizers>
    <userGroupProvider>
        <identifier>file-user-group-provider</identifier>
        <class>org.apache.nifi.authorization.FileUserGroupProvider</class>
        <property name="Users File">{{ users_xml_path }}</property>
        <property name="Initial User Identity 1">{{ charm_identity | e }}</property>
    </userGroupProvider>
    <accessPolicyProvider>
        <identifier>file-access-policy-provider</identifier>
        <class>org.apache.nifi.authorization.FileAccessPolicyProvider</class>
        <property name="User Group Provider">file-user-group-provider</property>
        <property name="Authorizations File">{{ authorizations_xml_path }}</property>
        <property name="Initial Admin Identity">{{ charm_identity | e }}</property>
    </accessPolicyProvider>
    <authorizer>
        <identifier>managed-authorizer</identifier>
        <class>org.apache.nifi.authorization.StandardManagedAuthorizer</class>
        <property name="Access Policy Provider">file-access-policy-provider</property>
    </authorizer>
</authorizers>
